<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZhongwenLens.App.Results.SavedWordsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zhongwen Lens Saved Words">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="ExportButton" Click="OnExport" Content="Export for Anki" />
                <Button x:Name="OpenFolderButton" Click="OnOpenFolder" Content="Open folder" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="WordList" Spacing="6" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0" FontSize="11" Opacity="0.6"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </Grid>
</Window>
