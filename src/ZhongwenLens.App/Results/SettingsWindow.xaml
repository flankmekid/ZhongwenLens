<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZhongwenLens.App.Results.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zhongwen Lens Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">

                <!-- Hotkey -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Snip hotkey" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Press a combination while recording. It must include Ctrl, Alt, Shift or Win."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="14,7" MinWidth="180" VerticalAlignment="Center">
                            <TextBlock x:Name="HotkeyText" FontFamily="Consolas" FontSize="14" />
                        </Border>
                        <Button x:Name="RecordButton" Click="OnRecordHotkey" Content="Change..."
                                VerticalAlignment="Center" />
                        <Button x:Name="ResetHotkeyButton" Click="OnResetHotkey" Content="Reset"
                                VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyStatus" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <!-- Startup -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Startup" FontSize="15" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Start Zhongwen Lens when I sign in"
                                  Toggled="OnStartupToggled" />
                </StackPanel>

                <!-- Reading -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Reading" FontSize="15" FontWeight="SemiBold" />

                    <ComboBox x:Name="LayoutCombo" Header="Pinyin placement" MinWidth="280"
                              SelectionChanged="OnLayoutChanged">
                        <ComboBoxItem Content="Automatic - beside short text, above long text" />
                        <ComboBoxItem Content="Always beside the text" />
                        <ComboBoxItem Content="Always above each word" />
                    </ComboBox>

                    <ComboBox x:Name="ScriptCombo" Header="Dictionary cards lead with" MinWidth="280"
                              SelectionChanged="OnScriptChanged">
                        <ComboBoxItem Content="Simplified" />
                        <ComboBoxItem Content="Traditional" />
                    </ComboBox>
                    <TextBlock Text="The snipped text itself is always shown as it appeared on screen."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

                    <ToggleSwitch x:Name="SpeakToggle" Header="Speak the selection automatically after each snip"
                                  Toggled="OnSpeakToggled" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="PathText" FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                       IsTextSelectionEnabled="True" />
            <Button x:Name="CloseButton" Click="OnClose" Content="Close" />
        </StackPanel>
    </Grid>
</Window>
