<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZhongwenLens.App.Results.ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZhongwenLens.App.Controls"
    Title="Zhongwen Lens">

    <Grid x:Name="Root"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Padding="18,14,18,14"
          IsTabStop="True"
          KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Headline. Word chips are built in code: the layout switches between side-by-side
             pinyin for short selections and ruby-above for long ones. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:WrapPanel x:Name="HeadlinePanel"
                                Grid.Column="0"
                                HorizontalSpacing="4"
                                VerticalSpacing="8"
                                VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="SpeakButton"
                        Click="OnSpeakAll"
                        AutomationProperties.Name="Speak the whole selection"
                        ToolTipService.ToolTip="Speak the whole selection"
                        Content="&#xE767;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="10,8" />
                <Button x:Name="CopyButton"
                        Click="OnCopy"
                        AutomationProperties.Name="Copy the text"
                        ToolTipService.ToolTip="Copy the text"
                        Content="&#xE8C8;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Padding="10,8" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                x:Name="MeaningPanel"
                Margin="0,12,0,0"
                Padding="12,9"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="Collapsed">
            <StackPanel Spacing="2">
                <TextBlock x:Name="MeaningLabel" FontSize="10" Opacity="0.55" />
                <TextBlock x:Name="MeaningText"
                           FontSize="15"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="Scroller" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Spacing="8" />
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Opacity="0.5" />
    </Grid>
</Window>
